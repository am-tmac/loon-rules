#!name=腾讯视频净化（Loon）
#!desc=原作者 ZenmoFeiShi；Loon 二进制适配。需启用 MitM 并信任证书。
#!author=@ZenmoFeiShi / am-tmac（Loon适配）
#!homepage=https://github.com/ZenmoFeiShi/Qx

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=TxvideoAD
http-response ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=TxvideoAD
http-response ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=TxvideoAD
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=TxvideoAD
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/Txvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=TxvideoAD

[Mitm]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
