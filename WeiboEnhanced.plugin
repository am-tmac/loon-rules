#!name=微博净化[墨鱼版]
#!desc=墨鱼微博助手 规则 V0.1.21（2026-10-12）· Loon 自动转换，脚本随原作者更新。设置页：Safari 打开 https://api.weibo.cn/__qx_weibo_settings__/
#!author=@ddgksf2013（原作）
#!homepage=https://ddgksf2013.top/rewrite/WeiboEnhanced.conf
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1063.png
#!tag=去广告
# 由 Scripts/convert_weibo.py 从 https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/QuantumultX/ddgksf2013/Official/WeiboEnhanced.conf 生成，勿手改

[Script]
http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/(?:api/config)?(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, timeout=60, tag=weibo_json
http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/api/(?:save|reset)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=weibo_json
http-response ^https?://api\.weibo\.cn(?:/2/statuses/container_timeline_hot|/2/guest/container_timeline_hot|/2/statuses/container_timeline_unread|/2/statuses/container_timeline|/2/live/media_homelist|/2/remind/hometab_dot|/2/remind/unread_count|/2/statuses/container_detail|/2/statuses/container_detail_comment|/2/comments/build_comments|/2/search/finder|/2/search/container_timeline|/2/search/container_discover|/2/!/was/finder/searchbarchange|/2/cardlist|/2/profile/me|/2/video/flow_stream|/2/video/flow_stream_cache|/2/push/daily|/2/push/active|/2/guest/push_active|/2/groups/allgroups/v2|/2/client/abserver_list|/2/checkin/show|/2/video/remind_info|/2/video/home_channels)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=weibo_json
http-response ^https?://bootpreload\.uve\.weibo\.com(?:/v2/ad/preload)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=weibo_json
http-response ^https?://wbapp\.uve\.weibo\.com(?:/wbapplua/wbpullad\.lua)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=weibo_json
# 补丁：隐藏「我」页面的「更多功能」
http-response ^https?://api\.weibo\.cn/2/profile/me(?=[?#]|$) script-path=https://raw.githubusercontent.com/am-tmac/loon-rules/main/Scripts/weibo_more_patch.js, requires-body=true, timeout=30, tag=微博更多功能补丁

[MITM]
hostname = api.weibo.cn, bootpreload.uve.weibo.com, wbapp.uve.weibo.com
