# NAME: Apple 智能 + Siri AI 全走美国节点（英语 Siri AI / 美版设备用）
# 来源: 小红书截图 Clash 规则（16 条）转 QX；与 AppleAI_Direct.list 互斥，二选一
# 用法: 强制策略设为美国节点；放在所有 Apple 分流规则之前
# Siri / Apple Intelligence
host, gateway.icloud.com, proxy
host-suffix, siri.apple.com, proxy
host, api-siri-prod.apple.com, proxy
host, wps.apple.com, proxy
host, probe.icloud.com, proxy
host, metrics.icloud.com, proxy
host, guzzoni.apple.com, proxy
host-suffix, smoot.apple.com, proxy
# Private Cloud Compute
host, apple-relay.apple.com, proxy
host, apple-relay.cloudflare.com, proxy
host, apple-relay.fastly-edge.com, proxy
host, cp4.cloudflare.com, proxy
# relay / bootstrap
host, apple-relay.mask.apple-dns.net, proxy
host, mask-api.icloud.com, proxy
host, mask-api.fe2.apple-dns.net, proxy
host, apple-relay.akamaized.net, proxy
host, apple-carry-relay.cloudflare.com, proxy
# 地区判定
host, gspe1-ssl.ls.apple.com, proxy
# ChatGPT 扩展
host-suffix, openai.com, proxy
host-suffix, chatgpt.com, proxy
# PCC 令牌发放 / 中继补充（@suiikal 实测攻略）
host-suffix, issuer.apple.com, proxy
host, ropes.apple.com, proxy
host, mask.icloud.com, proxy
host, mask-h2.icloud.com, proxy
host, mask.apple-dns.net, proxy
host, mask-api.fe.apple-dns.net, proxy
host-suffix, oaistatic.com, proxy
# 国行地区判定补充
host, gs-loc-cn.apple.com, proxy
host, smp-device-content.apple.com, proxy
host, setup.icloud.com, proxy
host, p150-acsegateway.icloud.com, proxy
host-suffix, icloud-content.com, proxy
